  "edges": [
    {
      "from": "wind_turbine_selector",
      "to": "wind_turbine_foundation_analysis",
      "status": "ready",
      "mappings": [
        {
          "source": "data.tower.base_diameter",
          "target": "step_geo.sec_mast.mast_diameter",
          "transform": "pass through, m"
        },
        {
          "source": "data.tower.base_vert_force",
          "target": "step_geo.sec_mast.mast_vertical_load",
          "transform": "pass through, kN"
        },
        {
          "source": "data.tower.base_horiz_force",
          "target": "step_geo.sec_mast.mast_horizontal_load",
          "transform": "pass through, kN"
        },
        {
          "source": "data.tower.base_moment",
          "target": "step_geo.sec_mast.mast_moment",
          "transform": "pass through, kNm"
        }
      ]
    },
    {
      "from": "wind_turbine_foundation_analysis",
      "to": "cpt_pile_bearing",
      "status": "ready_with_engineering_transform",
      "mappings": [
        {
          "source": "data.Maximum pile reaction (Rz)",
          "target": "step2.sec_load.design_load",
          "transform": "pass through, kN"
        },
        {
          "source": "params.step_geo.sec_piles.pile_diameter",
          "target": "step2.sec_pile.pile_diameter",
          "transform": "pass through, mm"
        },
        {
          "source": "CPT required depth result",
          "target": "params.step_geo.sec_piles.pile_length",
          "transform": "agent calls set_params_in_node to patch foundation params and storage without rerunning SCIA"
        }
      ]
    },
    {
      "from": "wind_turbine_foundation_analysis",
      "to": "reinforcement",
      "status": "partially_blocked",
      "mappings": [
        {
          "source": "design rule",
          "target": "tab_geometry.width",
          "transform": "use a 1000 mm representative strip width for kNm/m plate moments unless the user requests another strip width"
        },
        {
          "source": "params.step_geo.sec_plate.slab_thickness",
          "target": "tab_geometry.height",
          "transform": "m to mm for section depth"
        },
        {
          "source": "data.Minimum m_xD+, data.Maximum m_xD-",
          "target": "tab_loading.combinations",
          "transform": "map to two reinforcement load combinations with labels Min m_xD+ and Max m_xD-, M_Ed from the matching moment, and N_Ed = 0 kN for the representative strip"
        }
      ]
    },
    {
      "from": "wind_turbine_foundation_analysis",
      "to": "wind_turbine_cost_analysis",
      "status": "ready",
      "mappings": [
        {
          "source": "params.step_geo.sec_mast.mast_diameter",
          "target": "step_1.mast.d_mast",
          "transform": "m, round if app requires integer"
        },
        {
          "source": "params.step_geo.sec_plate.slab_diameter",
          "target": "step_1.plate.d_plate",
          "transform": "m, round if app requires integer"
        },
        {
          "source": "params.step_geo.sec_plate.slab_thickness",
          "target": "step_1.plate.t_centre",
          "transform": "m, round if app requires integer"
        },
        {
          "source": "params.step_geo.sec_plate.plate_edge_thickness",
          "target": "step_1.plate.t_edge",
          "transform": "m, round if app requires integer"
        },
        {
          "source": "params.step_geo.sec_plate.pedestal_height",
          "target": "step_1.plate.h_pedestal",
          "transform": "pass through, m"
        },
        {
          "source": "params.step_geo.sec_piles.num_piles",
          "target": "step_1.piles.n_piles",
          "transform": "pass through"
        },
        {
          "source": "params.step_geo.sec_piles.pile_length",
          "target": "step_1.piles.pile_length",
          "transform": "m, round if app requires integer"
        },
        {
          "source": "params.step_geo.sec_piles.pile_diameter",
          "target": "step_1.piles.pile_diameter",
          "transform": "pass through, mm"
        }
      ]
    },
    {
      "from": "reinforcement",
      "to": "wind_turbine_cost_analysis",
      "status": "ready_with_engineering_transform",
      "mappings": [
        {
          "source": "data.section.kg_m3",
          "target": "step_1.rebar.plate_main_reinforcement",
          "transform": "use as estimated reinforcement intensity in kg/m3 or replace with project plate reinforcement assumption"
        },
        {
          "source": "data.section.A_s and data.section.A_s2",
          "target": "step_1.rebar.multiplication_factor",
          "transform": "derive top/bottom reinforcement multiplier when needed; default is 2.0"
        }
      ]
    }
  ],
  "default_sequence": [
    "wind_turbine_selector",
    "wind_turbine_foundation_analysis",
    "cpt_pile_bearing",
    "reinforcement",
    "wind_turbine_cost_analysis"
  ]
}
